{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "core/**/*.ts",
    "combat/**/*.ts",
    "fighter/**/*.ts",
    "hit_system/**/*.ts",
    "combo_system/**/*.ts",
    "skill_system/**/*.ts",
    "animation/**/*.ts",
    "ai_system/**/*.ts",
    "network/**/*.ts",
    "ui/**/*.ts",
    "src/**/*.ts",
    "tests/**/*.ts",
    "vite.config.ts"
  ]
}
